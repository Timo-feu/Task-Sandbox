<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <ProjectReference Include="..\backend.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyAgentBackend" AfterTargets="Build">
    <ItemGroup>
      <AgentBackendFiles Include="$(MSBuildProjectDirectory)\..\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(AgentBackendFiles)"
      DestinationFiles="@(AgentBackendFiles->'$(OutDir)Agent\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
